<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pause.keyboard">

    <!-- The InputMethodService is declared here in the library manifest.
         The app module's manifest will merge this when building the APK. -->

    <service
        android:name=".PauseInputMethodService"
        android:label="@string/keyboard_name"
        android:permission="android.permission.BIND_INPUT_METHOD"
        android:exported="true">
        <intent-filter>
            <action android:name="android.view.InputMethod" />
        </intent-filter>

        <meta-data
            android:name="android.view.imelayout"
            android:resource="@xml.keyboard_settings" />
    </service>
</manifest>
